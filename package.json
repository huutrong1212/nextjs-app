{
  "name": "lms-frontdesk-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:local": "env-cmd -f .env.local next dev",
    "start:dev": "env-cmd -f .env.dev next dev",
    "start:pro": "env-cmd -f .env.production next dev",
    "start:staging": "env-cmd -f .env.staging next dev",
    "build:local": "env-cmd -f .env.local next build",
    "build:dev": "env-cmd -f .env.dev next build",
    "build:staging": "env-cmd -f .env.staging next build",
    "build:pro": "env-cmd -f .env.production next build",
    "start": "next start",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 200 --fix",
    "prepare": "husky install",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.0",
    "@iconify/react": "^5.0.1",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^5.40.1",
    "@tanstack/react-query-devtools": "^5.40.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "env-cmd": "^10.1.0",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.383.0",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.52.0",
    "react-icons": "^5.2.1",
    "react-intersection-observer": "^9.13.0",
    "react-select": "^5.8.0",
    "styled-components": "^6.1.12",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "8.0.3",
    "lint-staged": "14.0.1",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm format"
    ]
  }
}
